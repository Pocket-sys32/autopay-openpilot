[Unit]
Description=Comma parking Android and email worker
After=network-online.target appium.service android-emulator.service
Wants=network-online.target

[Service]
User=parking-demo
Group=parking-demo
WorkingDirectory=/opt/parking-demo
EnvironmentFile=/etc/parking-demo/backend.env
ExecStart=/opt/parking-demo/.venv/bin/python -m parking_backend.secret_exec /opt/parking-demo/.venv/bin/python -m parking_backend.worker
Restart=on-failure
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/parking-demo

[Install]
WantedBy=multi-user.target
